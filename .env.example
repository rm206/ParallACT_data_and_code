# prelim_suggestions (model that explores candidate tasks; any OpenAI-compatible server)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=
VLLM_API_KEY=EMPTY

# running_instances: only for the OpenRouter-backed backends
OPENROUTER_API_KEY=

# running_instances: where the model server is (default 127.0.0.1, port 8000 per model)
MODEL_HOST=127.0.0.1
# MODEL_PORT_QWEN=8000
# MODEL_PORT_DEEPSEEK=8000
# MODEL_PORT_GLM=8000

# eval: per-docker-run wall cap in seconds (default 2400)
EVAL_RUN_TIMEOUT=2400