{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "vllm": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1",
        "apiKey": "dummy"
      },
      "models": {
        "glm-5.3-flash": {
          "name": "glm-5.3-flash",
          "options": {
            "reasoningEffort": "xhigh"
          }
        }
      }
    }
  },
  "model": "vllm/glm-5.3-flash",
  "agent": {
    "worker": {
      "description": "General implementation subagent. Delegate a self-contained implementation task; it edits files in the repo and reports back when done.",
      "mode": "subagent",
      "model": "vllm/glm-5.3-flash"
    }
  }
}