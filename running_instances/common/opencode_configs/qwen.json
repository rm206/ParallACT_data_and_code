{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "vllm": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1",
        "apiKey": "dummy"
      },
      "models": {
        "qwen3-flash-next": {
          "name": "qwen3-flash-next",
          "options": {
            "reasoningEffort": "xhigh"
          }
        }
      }
    }
  },
  "model": "vllm/qwen3-flash-next",
  "agent": {
    "worker": {
      "description": "General implementation subagent. Delegate a self-contained implementation task; it edits files in the repo and reports back when done.",
      "mode": "subagent",
      "model": "vllm/qwen3-flash-next"
    }
  }
}